    },
    {
      "parameters": {
        "jsCode": "const contentBlocks = $input.first().json.content;\nconst textBlock = contentBlocks.find(b => b.type === 'text');\nconst voiceProfile = textBlock ? textBlock.text : '';\nconst url = $('On form submission').first().json['Website URL'];\nreturn [{ json: { voiceProfile, url } }];"
      },
      "id": "8c531e60-acbc-4d8f-be71-c4b485ed04d5",
      "name": "Parse Voice Profile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        -96
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-opus-5\", max_tokens: 2048, messages: [ { role: \"user\", content: \"Using this brand voice profile, write 5 Instagram posts that match the brand's voice. Each post needs a caption and a short set of relevant hashtags.\\n\\nVary the structure and length across the 5 — don't repeat the same shape five times. For example: one short and punchy (2-3 lines total), one framed as a direct question to spark comments, one list or quick-tip style post, and the rest can use a fuller narrative style. Mix short and long captions across the set rather than keeping them uniform.\\n\\nAdd a few emojis naturally for warmth, used sparingly — not in every line, and not the same emoji repeated.\\n\\nSeparate the 5 posts clearly with '---'.\\n\\nBRAND VOICE PROFILE:\\n\" + $json.voiceProfile } ] }) }}",
        "options": {}
      },
      "id": "015be6c6-ba52-45e3-b737-5c62c859f1e5",
      "name": "Generate Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1168,
        -96
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "xNzYvSQ50I539Opw",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const contentBlocks = $input.first().json.content;\nconst textBlock = contentBlocks.find(b => b.type === 'text');\nconst postsText = textBlock ? textBlock.text : '';\nconst url = $('Parse Voice Profile').first().json.url;\nconst emailBody = `Instagram posts generated from: ${url}\\n\\n${postsText}`;\nreturn [{ json: { emailBody } }];"
      },
      "id": "10713610-a278-4a4e-af40-d79bbf865dc3",
      "name": "Format Email",
      "type": "n8n-nodes-base.code",
